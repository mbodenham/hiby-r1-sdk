                           sdio_card ? "x1600.msc1-wifi" : "x1600.msc0",
@@ -899,6 +1092,136 @@ static void x1600_msc_init(X1600Msc *s, bool sdio_card, hwaddr base,
     (void)irq_line;
 }
 
+/* ----------------------------------------------------------------- */
+/* PDMA (SoC DMAC, ingenic,x1600-pdma): descriptor-chain engine.       */
+/* Decoded from the stock kernel's ingenic_dma driver (vmlinux.bin     */
+/* 0x80400600-0x80402550) + the first-boot -d unimp trace (v0.70):     */
+/*   - per-channel regs at 0x13420000 + ch*0x40: +0x08 DTC (read:      */
+/*     progress count; the driver reads it via ingenic_dma_read_dtc),  */
+/*     +0x10 CTL (write bit0 = start; the IRQ handler writes 0 on      */
+/*     completion), +0x18 DDA (descriptor-chain base, physical RAM).   */
+/*   - global/IRQ block at 0x13421000: +0x04 IRQ pending (1 bit per    */
+/*     channel, read = raw & enable, write-1-clear acks), +0x0c IRQ    */
+/*     enable. The probe's +0x00=1 / +0x30=1 writes are stored with    */
+/*     no pinned semantics (persistent regfile elsewhere).             */
+/*   - IRQ: INTC line 3 (DTB interrupts <3> "pdma"); line 4 ("pdmad")  */
+/*     is the dedicated-line variant reading +0x1010, line 5 the MCU   */
+/*     node's pdmam (a no-op stub handler in the kernel).              */
+/*   - Descriptor: 16-byte record {cmd, sadr, dadr, dln} in guest RAM; */
+/*     prep_slave_sg lays the chain out contiguously; cmd bit1 = last  */
+/*     descriptor; the msc path's cmd = 0x80 (fifo-side width 4) with  */
+/*     bit0 (IRQ-enable) ORed per descriptor. The CTL register value   */
+/*     the driver writes = 0x40000001 (swdesc template | start).       */
+/*   - Transfer direction/instance come from the descriptor content:   */
+/*     the slave_config put the MSC FIFO address (0x13450038 RX /      */
+/*     0x1345003c TX, same for msc1 at 0x1346xxxx) into SADR (RX) or   */
+/*     DADR (TX); the other side is the mapped buffer address.         */
+/*   - Completion: pending bit (gated by the enable), INTC line 3; the */
+/*     driver's handler acks, writes CTL=0, frees the descriptor       */
+/*     block and re-arms queued work. DTC is reported 0 (complete).    */
+/* Model execution is synchronous: the channel arms on the CTL write   */
+/* (the driver programs the DMA before the MSC command) and the data   */
+/* moves when the MSC model executes the matching CMD53 data phase     */
+/* (x1600_pdma_msc_data).                                              */
+/* ----------------------------------------------------------------- */
+
+#define X1600_PDMA_NCH      16
+#define X1600_PDMA_CH_SIZE  0x40
+#define X1600_PDMA_GBL      0x1000      /* IRQ block offset */
+#define X1600_PDMA_PENDING  (X1600_PDMA_GBL + 0x04)
+#define X1600_PDMA_ENABLE   (X1600_PDMA_GBL + 0x0c)
+
+typedef struct X1600Pdma {
+    MemoryRegion mmio;
+    qemu_irq irq;
+    uint32_t regs[0x10000 / 4];     /* persistent backing, stub semantics
+                                     * for everything not interpreted */
+    bool armed[X1600_PDMA_NCH];     /* started, waiting for the MSC cmd */
+    uint32_t desc[X1600_PDMA_NCH];  /* armed chain base (the DDA value) */
+} X1600Pdma;
+
+static X1600Pdma x1600_pdma_dev;
+
+static void x1600_pdma_update_irq(X1600Pdma *p)
+{
+    uint32_t pend = p->regs[X1600_PDMA_PENDING / 4] &
+                    p->regs[X1600_PDMA_ENABLE / 4];
+
+    qemu_set_irq(p->irq, pend != 0);
+}
+
+/* Channel completion path (reserved: the wifi data path turned out to
+ * run on the MSC's internal DMA; the SoC PDMA channels seen in the boot
+ * so far belong to the audio PCM engine and are left armed). */
+
+static uint64_t x1600_pdma_read(void *opaque, hwaddr addr, unsigned size)
+{
+    X1600Pdma *p = opaque;
+    uint64_t ret;
+
+    if (addr < X1600_PDMA_GBL) {
+        unsigned ch = addr / X1600_PDMA_CH_SIZE;
+
+        ret = p->regs[ch * X1600_PDMA_CH_SIZE / 4 +
+                      (addr % X1600_PDMA_CH_SIZE) / 4];
+    } else if (addr == X1600_PDMA_PENDING) {
+        ret = p->regs[X1600_PDMA_PENDING / 4] &
+              p->regs[X1600_PDMA_ENABLE / 4];
+    } else if (addr < 0x10000) {
+        ret = p->regs[addr / 4];
+    } else {
+        ret = 0;
+    }
+    qemu_log_mask(LOG_UNIMP, "x1600-pdma read %#llx = %#llx\n",
+                  (unsigned long long)addr, (unsigned long long)ret);
+    return ret;
+}
+
+static void x1600_pdma_write(void *opaque, hwaddr addr,
+                             uint64_t val, unsigned size)
+{
+    X1600Pdma *p = opaque;
+
+    if (addr >= 0x10000) {
+        return;
+    }
+    if (addr == X1600_PDMA_PENDING) {
+        p->regs[X1600_PDMA_PENDING / 4] &= ~val;    /* write-1-clear */
+        x1600_pdma_update_irq(p);
+        return;
+    }
+    p->regs[addr / 4] = val;
+    if (addr < X1600_PDMA_GBL) {
+        unsigned ch = addr / X1600_PDMA_CH_SIZE;
+        unsigned off = addr % X1600_PDMA_CH_SIZE;
+
+        if (off == 0x10 && (val & 1)) {
+            /* start: the driver's order is issue_pending (this write)
+             * before the peripheral command, so only arm; the data
+             * moves when the peripheral model runs the matching
+             * transfer. */
+            p->armed[ch] = true;
+            p->desc[ch] = p->regs[(ch * X1600_PDMA_CH_SIZE + 0x18) / 4];
+            qemu_log_mask(LOG_UNIMP,
+                          "x1600-pdma ch%u start ctl=%#llx dda=%#llx\n",
+                          ch, (unsigned long long)val,
+                          (unsigned long long)p->desc[ch]);
+        }
+        return;
+    }
+    if (addr == X1600_PDMA_ENABLE) {
+        x1600_pdma_update_irq(p);
