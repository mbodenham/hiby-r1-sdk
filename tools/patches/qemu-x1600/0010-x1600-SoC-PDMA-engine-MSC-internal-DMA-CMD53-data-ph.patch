From e897c22cad600eda8bb233bd13c8c156e8f0c3b8 Mon Sep 17 00:00:00 2001
From: Matthew Bodenham <matthew@bodenham.me>
Date: Wed, 14 Oct 2026 15:14:44 +0900
Subject: [PATCH] x1600: SoC PDMA engine + MSC internal DMA (CMD53 data phase +
 fn-space reads/writes)

- PDMA (ingenic,x1600-pdma) at 0x13420000: 16 channels (stride 0x40,
  DTC +0x08 / CTL +0x10 bit0 start / DDA +0x18 descriptor base),
  global IRQ block at +0x1000 (pending +0x04 write-1-clear gated by
  enable +0x0c, 1 bit per channel, INTC line 3), persistent regfile
  elsewhere. Register map + semantics decoded from the stock kernel's
  ingenic_dma driver and verified against the first-boot -d unimp
  trace (probe writes +0x1000=1/+0x1030=1; the audio PCM channel arms
  with DDA/enable/CTL 0x40000001 around the 250 s mark).
- MSC internal DMA (the wifi 512-byte data path, decoded from the
  live soc_msc.ko): the driver stages the CMD53 phase, writes
  MSC_DMADA (0x48) = the first descriptor's physical address then
  MSC_DMAC (0x44) with bit0; the model walks the 16-byte descriptor
  {dcmd, dat(phys), dln, flags-bit0=end} and moves the data between
  guest memory and the SDIO function space (CIS at fn0 0x1000+, CCCR,
  the backplane window chunks), raising the msc data-done source
  (IFLG bit15) which drives the driver's thread state 4.
- CMD53 generalization: fn-space byte reader/writer shared with the
  CMD52 semantics (fn0 CCCR/CIS, fn1 SBADDR window regs, ChipClkCSR
  ALP/HT mirrors, 32K backplane window chunks incl. the
  [0x80000,0x18000000) unmapped 0xff rule); multi-block phases
  (cnt > 512) stage for the DMA kick; PIO path unchanged.
- Boot window unchanged (gate boot-baseline-v0.70 PASS): the DHD
  probe still fails in si_doattach after the RAM-size walk, before
  any 512-byte CMD53 is issued; the DMA paths are stage-ready.
---
 hw/mips/x1600.c | 442 ++++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 386 insertions(+), 56 deletions(-)

diff --git a/hw/mips/x1600.c b/hw/mips/x1600.c
index f52ecdd..cad284a 100644
--- a/hw/mips/x1600.c
+++ b/hw/mips/x1600.c
@@ -444,6 +444,7 @@ typedef struct X1600Msc {
     MemoryRegion mmio;
     qemu_irq irq;
     bool sdio_card;             /* SDIO wifi present (msc1) */
+    unsigned index;             /* 0 = msc0 (wifi), 1 = msc1 (TF slot) */
     uint32_t regs[0x100 / 4];
     uint16_t rca;
     uint8_t cccr[0x1000];       /* func0 space: CCCR 0x00-0xff, FBRs,
@@ -454,6 +455,12 @@ typedef struct X1600Msc {
     uint8_t fifo[512];          /* CMD53 data phase (PIO: soc_msc pops
                                  * words from MSC_RXFIFO) */
     unsigned fifo_len, fifo_pos;
+    /* staged CMD53 data phase, completed by the internal-DMA kick
+     * (the driver writes MSC_DMAC after MSC_CTRL) */
+    bool dma_pending, dma_wr, dma_inc;
+    unsigned dma_len;
+    unsigned dma_fn;
+    uint32_t dma_addr;
     uint8_t *bp_chunks[16];     /* backplane window content, one 32 KB
                                  * chunk per SBADDR key (the BCM window
                                  * = 32 KB at (SBADDR<<8) & ~0x7fff);
@@ -477,6 +484,28 @@ static void x1600_msc_update_irq(X1600Msc *s)
     qemu_set_irq(s->irq, pending != 0);
 }
 
+/* Backplane window chunk lookup/create: the 32 KB bank at fn1
+ * 0x8000-0xffff maps (SBADDR << 8) | (addr & 0x7fff) to a cached chunk
+ * keyed by the backplane address >> 15. */
+static uint8_t *x1600_msc_bp_chunk(X1600Msc *s, uint32_t bp)
+{
+    unsigned ci;
+
+    for (ci = 0; ci < 16; ci++) {
+        if (s->bp_chunks[ci] && s->bp_keys[ci] == (bp >> 15)) {
+            return s->bp_chunks[ci];
+        }
+    }
+    for (ci = 0; ci < 16; ci++) {
+        if (!s->bp_chunks[ci]) {
+            s->bp_chunks[ci] = g_malloc0(0x8000);
+            s->bp_keys[ci] = bp >> 15;
+            return s->bp_chunks[ci];
+        }
+    }
+    return NULL;
+}
+
 /* CMD52 IO_RW_DIRECT: arg = {rw(31), func(28:26), raw(27), addr(25:9),
  * data(7:0)}; R5 response — the core extracts the data byte as
  * resp[0] & 0xFF (mmc_io_rw_direct_host), so the byte sits in the RES
@@ -575,6 +604,99 @@ static uint32_t x1600_msc_res_pop(X1600Msc *s)
     }
 }
 
+/* One byte of an SDIO function's address space (the CMD52 semantics,
+ * shared with the CMD53 data phase). Returns the byte on *ok; fn0
+ * covers the CCCR/FBR block (0x00-0xfff) and the CIS chains at
+ * 0x1000+, fn1 the backplane space (SBADDR window regs, ChipClkCSR,
+ * the 32 KB window bank at 0x8000+). */
+static uint8_t x1600_msc_fn_read(X1600Msc *s, unsigned fn, uint32_t addr,
+                                 bool *ok)
+{
+    if (fn == 0) {
+        if (addr < sizeof(s->cccr)) {
+            *ok = true;
+            return s->cccr[addr];
+        }
+        if (addr - 0x1000 < sizeof(s->cis)) {
+            *ok = true;
+            return s->cis[addr - 0x1000];
+        }
+        *ok = false;
+        return 0;
+    }
+    if (fn == 1 && addr < sizeof(s->fn1)) {
+        if (addr == 0x1000e) {
+            uint8_t d = s->fn1[addr];
+
+            d |= (d & 0x20) ? 0x40 : 0;     /* ALP_AVAIL */
+            d |= (d & 0x10) ? 0x80 : 0;     /* HT_AVAIL */
+            *ok = true;
+            return d;
+        }
+        if (addr >= 0x8000) {
+            uint32_t sbaddr = s->fn1[0x1000a] | (s->fn1[0x1000b] << 8) |
+                              (s->fn1[0x1000c] << 16);
+            uint32_t bp = (sbaddr << 8) | (addr & 0x7fff);
+
+            *ok = true;
+            if (bp >= 0x80000 && bp < 0x18000000) {
+                return 0xff;                /* unmapped backplane */
+            }
+            if ((bp & 0x7fff) < 0x8000) {
+                uint8_t *chunk = x1600_msc_bp_chunk(s, bp);
+
+                if (chunk) {
+                    return chunk[bp & 0x7fff];
+                }
+            }
+            return 0xff;
+        }
+        *ok = true;
+        return s->fn1[addr];
+    }
+    *ok = false;
+    return 0;
+}
+
+/* CMD53 write side of the same space. */
+static bool x1600_msc_fn_write(X1600Msc *s, unsigned fn, uint32_t addr,
+                               uint8_t val)
+{
+    if (fn == 0 && addr < sizeof(s->cccr)) {
+        s->cccr[addr] = val;
+        /* CCCR 0x02 (IO Enable) -> 0x03 (IO Ready): the vendor core's
+         * sdio_enable_func polls CCCR 0x03 for the same bit (v0.66). */
+        if (addr == 0x02) {
+            s->cccr[0x03] = val;
+        }
+        return true;
+    }
+    if (fn == 0 && addr - 0x1000 < sizeof(s->cis)) {
+        s->cis[addr - 0x1000] = val;
+        return true;
+    }
+    if (fn == 1 && addr < sizeof(s->fn1)) {
+        if (addr >= 0x8000) {
+            uint32_t sbaddr = s->fn1[0x1000a] | (s->fn1[0x1000b] << 8) |
+                              (s->fn1[0x1000c] << 16);
+            uint32_t bp = (sbaddr << 8) | (addr & 0x7fff);
+
+            if ((bp & 0x7fff) < 0x8000) {
+                uint8_t *chunk = x1600_msc_bp_chunk(s, bp);
+
+                if (chunk) {
+                    chunk[bp & 0x7fff] = val;
+                    return true;
+                }
+            }
+            return false;
+        }
+        s->fn1[addr] = val;
+        return true;
+    }
+    return false;
+}
+
 static void x1600_msc_command(X1600Msc *s)
 {
     uint32_t op = s->regs[MSC_CMD / 4] & 0x3f;
@@ -617,75 +739,73 @@ static void x1600_msc_command(X1600Msc *s)
             break;
         case 53: {                      /* CMD53 IO_RW_EXTENDED (R5) */
             /* arg = {rw(31), fn(30:28), blkmode(27), op(26), addr(25:9),
-             * count(8:0)}; the vendor core packs fn at <<28
-             * (mmc_io_rw_direct_host: "sll s2,s2,0x1c"). The DHD's
-             * backplane reads are fn1 byte-mode CMD53s into the 32K
-             * window bank at 0x8000-0xffff; the data rides the PIO
-             * FIFO (soc_msc polls STAT bit6, then reads MSC_RXFIFO
