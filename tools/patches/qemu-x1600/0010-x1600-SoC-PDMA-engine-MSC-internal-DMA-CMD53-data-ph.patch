@@ -788,6 +908,78 @@ static void x1600_msc_write(void *opaque, hwaddr addr,
     if (addr == MSC_IMASK) {
         x1600_msc_update_irq(s);
     }
+    if (addr == MSC_DMAC && (val & 1) && s->dma_pending) {
+        /* internal-DMA kick (v0.71): the driver stages the sg into its
+         * uncached descriptor ring, writes MSC_DMADA (0x48) = the first
+         * descriptor's physical address and then MSC_DMAC (0x44) with
+         * bit0 set - the controller walks the descriptor chain and
+         * moves the data; completion raises the MSC data-done source
+         * (IFLG bit15, ingenic_mmc_thread_handle's last pending case ->
+         * state 4 -> data_done). Descriptor: {dcmd, dat(phys), dln,
+         * flags}; flags bit0 = end-of-chain (the sdio core's helper
+         * issues one sg entry per CMD53, so one descriptor carries the
+         * whole phase). */
+        uint32_t desc[4], dat, dln;
+        unsigned n, off = 0, i;
+        bool ok = true;
+
+        if (dma_memory_read(&address_space_memory, s->regs[0x48 / 4], desc,
+                            sizeof(desc), MEMTXATTRS_UNSPECIFIED)
+            == MEMTX_OK) {
+            dat = desc[1];
+            dln = desc[2];
+            n = dln > s->dma_len ? s->dma_len : dln;
+            while (off < n && ok) {
+                unsigned chunk = n - off > sizeof(s->fifo) ?
+                                 sizeof(s->fifo) : n - off;
+
+                if (!s->dma_wr) {
+                    for (i = 0; i < chunk; i++) {
+                        s->fifo[i] = x1600_msc_fn_read(s, s->dma_fn,
+                                                       s->dma_inc ?
+                                                       s->dma_addr + off + i :
+                                                       s->dma_addr, &ok);
+                        if (!ok) {
+                            break;
+                        }
+                    }
+                    if (ok && dma_memory_write(&address_space_memory,
+                                               dat + off, s->fifo, chunk,
+                                               MEMTXATTRS_UNSPECIFIED)
+                        != MEMTX_OK) {
+                        ok = false;
+                    }
+                } else {
+                    if (dma_memory_read(&address_space_memory, dat + off,
+                                        s->fifo, chunk,
+                                        MEMTXATTRS_UNSPECIFIED)
+                        != MEMTX_OK) {
+                        ok = false;
+                        break;
+                    }
+                    for (i = 0; i < chunk; i++) {
+                        if (!x1600_msc_fn_write(s, s->dma_fn,
+                                                s->dma_inc ?
+                                                s->dma_addr + off + i :
+                                                s->dma_addr, s->fifo[i])) {
+                            ok = false;
+                            break;
+                        }
+                    }
+                }
+                off += chunk;
+            }
+        } else {
+            ok = false;
+        }
+        s->dma_pending = false;
+        if (ok) {
+            s->regs[MSC_STAT / 4] |= s->dma_wr ? STAT_XFER_DONE_WR
+                                               : STAT_XFER_DONE_RD;
+            s->regs[MSC_IFLG / 4] |= 0x8000u;   /* data done */
+            x1600_msc_update_irq(s);
+        }
+    }
 }
 
 static const MemoryRegionOps x1600_msc_ops = {
@@ -891,6 +1083,7 @@ static void x1600_msc_init(X1600Msc *s, bool sdio_card, hwaddr base,
     memcpy(s->cis + 0x200, x1600_msc_cis_f1, sizeof(x1600_msc_cis_f1));
     memcpy(s->cis + 0x300, x1600_msc_cis_f2, sizeof(x1600_msc_cis_f2));
