From 9f1e2d3c4b5a697887766554433221100ffeedd Mon Sep 17 00:00:00 2001
From: fw-dl-round <fw-dl@local>
Date: Thu, 15 Oct 2026 13:00:58 +0900
Subject: [PATCH] x1600-msc: wifi control-response chain completes (read-DMA done via IFLG bit31, polling bit6 clear, SDPCM control header, DHD credits, CDC id echo, chanspecs/per_chan_info payloads, PA08 re-kick)

v0.87 (the wifi fw-download round 4-5). The control exchange now
completes end-to-end: dhd_bus_txctl's frame lands, the DPC's readframes
picks the staged response off fn2, dhdcdc_cmplt matches the ioctl id
through id 32+, 28 preinit ioctls complete (cur_etheraddr, cap, toe_ol,
p2p, nmode, vhtmode, tx/rx-streams, ldpc/stbc, txbf caps, mimo_bw_cap,
chanspecs, per_chan_info), and `ifconfig wlan1 up` returns 0 with
"Firmware up" (wl_android_wifi_on + dhd_open complete; the firmware
download itself stays skipped by the driver design, documented in
M1-bringup-log v0.83). The stock boot gate passes byte-identical.

Model changes (all decoded from soc_msc.ko / cywdhd.ko, see
docs/M1-bringup-log.md v0.86-v0.87):

- read-DMA completions raise IFLG bit31, not bit23: the request fn's
  DMA branch does IMASK &= ~dcmd with READ dcmd 0x80000900 -> final
  IMASK 0x7ffff6fb which MASKS bit23 and ENABLES bit31; the thread maps
  either bit onto the state-2 event flag and runs data_done. The old
  bit23 raise on a read sat pending until request_timeout stored -159
  (the run14 ERR=-159). Writes keep bit23 (their IMASK enables it,
  runtime-verified ack 0x00810003). The per-command stale tail clears
  both bits.
- STAT bit6 (RXFIFO_RDY) is never set at staging: the request fn's
  polling READ loop (sg length < 64 -> the word loops) SPINS while
  bit6 is set and pops MSC_RXFIFO when clear; staging bit6 for
  BLKLEN<64 deadlocked the 4-byte window reads (v0.86 run15: 6.9 GB of
  STAT re-polls at request+0x6bc, then a hard guest wedge). STAT
  bit12/13 staging stays for the polling_status tail.
- the walk serves the staged fifo (fifo_len == dma_len, fn2 reads are
  destructive) and carries a bounded-iteration guard (4096 x 512-byte
  chunks) so a model-side stuck loop can never wedge the guest.
- the >512-byte CMD53 staging branch clears fifo_len so the walk's
  staged-fifo check cannot false-match on a stale length.
- ctl_rx (the chip-side control-response surface) now builds the SDPCM
  header the DHD's readframes parses: [4] seq = the ioctl id, [5]
  channel 0 (CONTROL - the channel the ctrl-buffer handler dispatches
  on; the request's byte carries 1 and the response must override it),
  [6] nextlen 0, [7] dataoffset 32 (the CDC header offset; must be
  >= 12), and echoes the CDC cmd/len/flags verbatim (the DHD's id
  counter passes 32; truncating the id to 5 bits made dhdcdc_cmplt
  never match). Byte 9 carries the credit-grant watermark (the DHD's
  sendable credits = (byte9 - its tx_seq) mod 256; byte9 = 0 gave a
  negative window and deadlocked dhd_bus_txctl's ctrl_frame_stat wait).
  cur_etheraddr returns the module-param MAC; chanspecs returns the
  2.4 GHz 20 MHz wl_uint32_list (13 x 0x1000|ch; the format decoded
  from the DHD's own masks at cywdhd 0x4ebcc); per_chan_info returns
  the 2.4 G capability bitmap 0x3ffe. The fn2_rd FIFO is 2048 bytes
  (the control responses outgrew 512).
- a delayed PA08 re-assert (10 ms after each fn2 frame read, one shot,
  skipped while a fresh response is staged): the DHD's dhd_bus_txctl
  skips its own DPC wake whenever dpc_sched is latched and trusts a
  pending DPC pass to send the staged frame; with the instant-PA08
  cadence the pending pass can already be past its stat-check, and
  without a follow-up OOB edge the txctl waits 5 s and fails
  (txcnt_timeout). The re-kick gives it that pass; harmless when idle.

Signed-off-by: fw-dl-round <fw-dl@local>

---
diff --git a/hw/mips/x1600.c b/hw/mips/x1600.c
index 911d8b2..4b8c202 100644
--- a/hw/mips/x1600.c
+++ b/hw/mips/x1600.c
@@ -46,7 +46,6 @@
 #include "ui/input.h"
 #include "target/mips/cpu.h"
 #include "qom/object.h"
-#include "chardev/char.h"
 #include "qemu/error-report.h"
 #include "qemu/log.h"
 #include "qemu/memalign.h"
@@ -441,6 +440,22 @@ static const MemoryRegionOps x1600_cgu_ops = {
 
 #define IFLG_END_CMD_RES    (1u << 2)
 #define IFLG_TIME_OUT_RES   (1u << 9)
+/* data-phase done sources (v0.86 decode of soc_msc.ko): the threaded irq
+ * handler maps pending bit23 (writes) AND pending bit31 (reads) onto the
+ * same state-2 event flag (host+1664 bit3) and runs the state machine,
+ * whose state-2 handler finds STAT&0x3f clean, calls ingenic_mmc_data_done
+ * and that tail-calls mmc_request_done with error 0. Which bit arrives is
+ * decided by the request fn's IMASK (0x1f0c/0x1ff0): WRITE dcmd 0x00800400
+ * unmask -> final IMASK 0xff7ff9fb (bit23 enabled); READ dcmd 0x80000900
+ * unmask -> final IMASK 0x7ffff6fb (bit23 masked, bit31 enabled) — a
+ * bit23 raise on a DMA READ is never seen by the thread (IFLG bit23 sits
+ * pending until request_timeout stores -159, the run14 ERR). Bits 8-12
+ * (0x1f00) are the module's ERROR cluster: any of them pending in states
+ * 1/2 acks 0x1f00/0x80801f00 and forces state 4, whose handler stores
+ * cmd->error = -1 whenever data is present (the v0.83 -1). Bit15 only
+ * feeds the dead state-3 flag. */
+#define IFLG_DATA_DONE      (1u << 23)
+#define IFLG_DATA_DONE_RD   (1u << 31)
 
 typedef struct X1600Msc {
     MemoryRegion mmio;
@@ -462,6 +477,19 @@ typedef struct X1600Msc {
                                  * at fn2 0x0000, the 64-byte frame as a
                                  * byte-mode CMD53 count=64 at fn2 0x8000,
                                  * v0.83 run7) */
+    bool ctl_stage;             /* a control response is staged for the
+                                 * DHD's readframes (the PA08 host-wake is
+                                 * asserted; dropped on the intstatus
+                                 * W1C ack) */
+    uint8_t fn2_rd[2048];       /* fn2 read FIFO: the dongle's to-host
+                                 * frame stream (the DHD reads fn2 as a
+                                 * fixed-address data port — every CMD53
+                                 * pops the next bytes); loaded by
+                                 * ctl_rx, zeros when empty. 2048: the
+                                 * control responses grow past 512 with
+                                 * the preinit ioctls (the run17 "cap"
+                                 * query arrives as a 640-byte frame). */
+    unsigned fn2_rd_len, fn2_rd_pos;
     uint8_t fifo[512];          /* CMD53 data phase (PIO: soc_msc pops
                                  * words from MSC_RXFIFO) */
     unsigned fifo_len, fifo_pos;
@@ -482,11 +510,38 @@ typedef struct X1600Msc {
     unsigned res_reads;         /* RES byte-window state, see res_pop */
     unsigned res_count;
     uint8_t res_bytes[20];      /* 4 (32-bit resp) or 17 (R2) */
+    QEMUTimer *pa08_rekick;     /* the post-read host-wake re-assert:
+                                 * the DHD's dhd_bus_txctl skips its own
+                                 * DPC wake when dpc_sched is latched, so
+                                 * a pending control send needs one more
+                                 * OOB interrupt after the previous
+                                 * response is consumed */
 } X1600Msc;
 
 static X1600Msc x1600_msc_devs[2];
 static CPUMIPSState *x1600_msc_cpu;  /* DEBUG: guest PC in the trace */
 
+/* v0.76 input path (defined below, used across the models) */
+void x1600_input_sadc_set_key_mv(unsigned mv);
+void x1600_gpio_inject(unsigned bank, unsigned pin, bool level);
+void x1600_i2c_touch_report(bool touched, unsigned x, unsigned y);
+
+/* The delayed host-wake re-assert. Fired ~10 ms after a staged control
+ * response is consumed; a level-high PA08 edge re-runs the DHD's ISR
+ * and its DPC, whose next pass picks up a control frame the txctl
+ * thread staged in ctrl_frame_stat (the DHD skips its own DPC wake
+ * whenever dpc_sched is latched — the v0.87 run20 deadlock). Harmless
+ * when nothing is pending: the intstatus reads 0 and the pass idles. */
+static void x1600_msc_pa08_rekick(void *opaque)
+{
+    X1600Msc *s = opaque;
+
+    if (s->ctl_stage) {
+        return;                 /* a fresh response is already announced */
+    }
+    x1600_gpio_inject(0, 8, true);
+}
+
 static void x1600_msc_update_irq(X1600Msc *s)
 {
     uint32_t pending = s->regs[MSC_IFLG / 4] & ~s->regs[MSC_IMASK / 4];
@@ -526,6 +581,15 @@ static uint8_t *x1600_msc_bp_chunk(X1600Msc *s, uint32_t bp)
  * [0x80000, 0x18000000) is unmapped and reads 0xff). */
 static uint8_t x1600_msc_bp_read(X1600Msc *s, uint32_t bp)
 {
+    /* the SDIO device core's intstatus read is the DPC's gate: serve
+     * the frame/host bits while a control response is staged (v0.85
+     * run11 — without it the DPC re-arms without ever calling
+     * readframes) */
+    if (bp == 0x18002020) {
+        uint8_t v = s->ctl_stage ? 0xc0 : 0;
+
+        return v;
+    }
     if (bp >= 0x18100000u && bp < 0x18108000u) {
         uint32_t off = bp & 0xfff;
 
@@ -553,6 +617,9 @@ static uint32_t x1600_msc_cmd52(X1600Msc *s, uint32_t arg)
     uint8_t data = arg & 0xff;
     uint8_t *space = NULL;
 
+    if (func == 1 && addr - 0x1000aU < 5U) {
+    }
+
     if (func == 0 && addr < sizeof(s->cccr)) {
         space = s->cccr + addr;
     } else if (func == 0 && addr - 0x1000 < sizeof(s->cis)) {
@@ -700,14 +767,17 @@ static uint8_t x1600_msc_fn_read(X1600Msc *s, unsigned fn, uint32_t addr,
         return s->fn1[addr];
     }
     if (fn == 2 && addr < sizeof(s->fn2)) {
-        /* fn2: the dongle data function. The DHD's control TX targets
-         * fn2 0x0000 (the 384-byte frame, block-mode count=3 x BLKLEN)
-         * and fn2 0x8000 (the 64-byte frame, byte-mode count=64); the
-         * data phase runs through the MSC internal DMA and lands here
-         * (v0.83 run7). Reads return the model's staged bytes (the
-         * chip-side protocol serves them later). */
+        /* fn2: the dongle data function. Writes stage the host's frame
+         * for the chip-side protocol (ctl_rx); READS are the to-host
+         * data port — the DHD reads it as a FIXED-address stream (the
+         * run11 trace: a 128-byte read at fn2 0x8000 op=0), so each
+         * read pops the next byte of the loaded response frame, zeros
+         * once empty. */
         *ok = true;
-        return s->fn2[addr];
+        if (s->fn2_rd_pos < s->fn2_rd_len) {
+            return s->fn2_rd[s->fn2_rd_pos++];
+        }
+        return 0;
     }
     *ok = false;
     return 0;
@@ -738,6 +808,13 @@ static bool x1600_msc_fn_write(X1600Msc *s, unsigned fn, uint32_t addr,
             uint32_t bp = (sbaddr << 8) | (addr & 0x7fff);
 
             if ((bp & 0x7fff) < 0x8000) {
+                /* the SDIO core's intstatus W1C: the dpc's ack after it
+                 * consumed the staged response */
+                if (bp == 0x18002020) {
+                    s->ctl_stage = false;
+                    x1600_gpio_inject(0, 8, false);
+                    return true;
+                }
                 uint8_t *chunk = x1600_msc_bp_chunk(s, bp);
 
                 if (chunk) {
@@ -757,6 +834,146 @@ static bool x1600_msc_fn_write(X1600Msc *s, unsigned fn, uint32_t addr,
     return false;
 }
 
+/* Chip-side control-protocol step (v0.84): the DHD just completed a
+ * control-frame WRITE to fn2 0x8000 (the CDC ioctl request). Parse the
+ * SDPCM frame the DHD put on the wire and stage the response in the same
+ * window, then assert the OOB host-wake (PA08, virq 101) so the DHD's
+ * dhdsdio_isr -> dhdsdio_dpc -> dhdsdio_readframes chain picks it up.
+ *
+ * Wire shape (v0.84 run4 dump of the DHD's own 384-byte QUERY frame):
+ *   [0:2] framelen LE, [2:4] ~framelen, [4] seq, [5] chan_flags,
+ *   [4:8] swheader (seq | chan<<8 | nextlen<<24), [8:32] the extended
+ *   header/framecheck region this DHD build carries (copied verbatim),
+ *   [32:44] CDC header {cmd, len, flags LE32s}, the ioctl id at
+ *   flags[19:16], payload at +48 (the iovar name for WLC_GET_VAR).
+ * The DHD's dhdcdc_cmplt waits for bus->rxseq == the ioctl id, so the
+ * response's SDPCM seq byte carries the id (the dongle echoes it). */
+static void x1600_msc_ctl_rx(X1600Msc *s)
+{
+    uint32_t base = 0x8000;
+    unsigned framelen, inv, id;
+    uint32_t cmd, clen, cflags;
+
+    framelen = s->fn2[base] | (s->fn2[base + 1] << 8);
+    inv = s->fn2[base + 2] | (s->fn2[base + 3] << 8);
+    if ((framelen ^ inv) != 0xffff || framelen < 48 || framelen > 2048) {
+        return;
+    }
+    cmd = s->fn2[base + 32] | (s->fn2[base + 33] << 8) |
+          (s->fn2[base + 34] << 16) | ((uint32_t)s->fn2[base + 35] << 24);
+    clen = s->fn2[base + 36] | (s->fn2[base + 37] << 8) |
+           (s->fn2[base + 38] << 16) | ((uint32_t)s->fn2[base + 39] << 24);
+    cflags = s->fn2[base + 40] | (s->fn2[base + 41] << 8) |
+             (s->fn2[base + 42] << 16) |
+             ((uint32_t)s->fn2[base + 43] << 24);
+    id = (cflags >> 16) & 0x1f;
+
+    /* CDC response at +32: cmd echoed, len = the payload length,
+     * flags = the id at [19:16] (no error bit). The value for
+     * WLC_GET_VAR "cur_etheraddr" = the module-param MAC the DHD's own
+     * boot path prints (dhd_module_init: 00:90:4c:11:22:33).
+     * The response frame is built from the request frame (the extended
+     * header region [5:32] is carried over) and loaded into the fn2
+     * to-host read FIFO — the DHD's readframes pops it off the port
+     * with fixed-address CMD53 reads.
+     * SDPCM header fields the DHD's readframes parses (v0.86 decode of
+     * cywdhd readframes 0x99718): [4] = seq, [5] = channel+flags (the
+     * low nibble dispatches: 0 = the CONTROL handler that memcpy's the
+     * frame into the ctrl buffer the ioctl completer reads — 1..3 go
+     * down the event/data pipeline and the response is never seen),
+     * [6] = nextlen (< 0x81), [7] = dataoffset (a byte, must be >= 12
+     * and <= framelen — 32 = the CDC header offset, the wire
+     * convention the DHD's own control TX uses). The request's [5]
+     * carries 1 (the DHD's TX-side channel convention) — the response
+     * must override both [5] and [7]. */
+    s->fn2[base + 4] = id;                      /* SDPCM seq = ioctl id */
+    s->fn2[base + 5] = 0;                       /* SDPCM channel = CONTROL */
+    s->fn2[base + 6] = 0;                       /* nextlen */
+    s->fn2[base + 7] = 32;                      /* dataoffset = CDC @ +32 */
+    s->fn2[base + 32] = cmd & 0xff;
+    s->fn2[base + 33] = (cmd >> 8) & 0xff;
+    s->fn2[base + 34] = (cmd >> 16) & 0xff;
+    s->fn2[base + 35] = (cmd >> 24) & 0xff;
+    /* CDC flags echoed verbatim: the DHD's ioctl id lives above bit 16
+     * and its counter passes 32 (the run19 id=32 request had flags
+     * 0x200000 — truncating the id to 5 bits made the response's id 0,
+     * dhdcdc_cmplt never matched and the rxctl timed out). The request
+     * carries no error bit, so the echo is a clean completion. */
+    s->fn2[base + 40] = cflags & 0xff;
+    s->fn2[base + 41] = (cflags >> 8) & 0xff;
+    s->fn2[base + 42] = (cflags >> 16) & 0xff;
+    s->fn2[base + 43] = (cflags >> 24) & 0xff;
+    if (cmd == 262 /* WLC_GET_VAR */ &&
+        memcmp(s->fn2 + base + 48, "cur_etheraddr", 13) == 0) {
+        static const uint8_t mac[6] = { 0x00, 0x90, 0x4c, 0x11, 0x22, 0x33 };
+        unsigned i;
+
+        for (i = 0; i < sizeof(mac); i++) {
+            s->fn2[base + 44 + i] = mac[i];
+        }
+        /* the payload occupies [44:50]: zero the gap the request had at
+         * [44:48] (the iovar name is not echoed) */
+        framelen = 50;
+        clen = sizeof(mac);
+    } else if (cmd == 262 &&
+               memcmp(s->fn2 + base + 48, "chanspecs", 9) == 0) {
+        /* wl_uint32_list of the 2.4 GHz 20 MHz chanspecs: the DHD's
+         * wl_construct_reginfo walks count + u32 entries (lhu reads the
+         * low 16). Chanspec format decoded from the DHD's own masks
+         * (cywdhd 0x4ebcc): (& 0x3000) == 0x1000 = WL_CHANSPEC_BW_20,
+         * (& 0xc000) == 0 = band 2G, low byte = the channel; the
+         * (& 0x3800) == 0x1800 combo is rejected. An empty payload left
+         * the count as stale-buffer garbage and the parse churned
+         * thousands of "Invalid channel Sepc" lines (run22). */
+        uint32_t *list = (uint32_t *)(void *)(s->fn2 + base + 44);
+        unsigned i;
+
+        list[0] = 13;
+        for (i = 0; i < 13; i++) {
+            list[1 + i] = 0x1000u | (i + 1);
+        }
+        framelen = 44 + 4 + 13 * 4;
+        clen = 4 + 13 * 4;
+    } else if (cmd == 262 &&
+               memcmp(s->fn2 + base + 48, "per_chan_info", 13) == 0) {
+        /* getint: the 2.4 GHz channel-capability bitmap (channels 1-13) */
+        uint32_t *val = (uint32_t *)(void *)(s->fn2 + base + 44);
+
+        val[0] = 0x3ffeu;
+        framelen = 48;
+        clen = 4;
+    } else {
+        /* unhandled request: empty payload, the DHD reports the failure
+         * and the next boot step dictates what to grow (v0.84) */
+        memset(s->fn2 + base + 44, 0, 8);
+        framelen = 44;
+        clen = 0;
+    }
+    s->fn2[base + 36] = clen & 0xff;
+    s->fn2[base + 37] = (clen >> 8) & 0xff;
+    s->fn2[base + 38] = 0;
+    s->fn2[base + 39] = 0;
+    s->fn2[base] = framelen & 0xff;
+    s->fn2[base + 1] = (framelen >> 8) & 0xff;
+    s->fn2[base + 2] = (~(uint8_t)(framelen & 0xff)) & 0xff;
+    s->fn2[base + 3] = (~((framelen >> 8) & 0xff)) & 0xff;
+    /* SDPCM byte 9 = the dongle's credit-grant watermark: the DHD's
+     * sendable credits = (byte9 - its tx_seq) mod 256, and readframes
+     * flags a backward grant ((byte9 - txseq) & 0xff >= 0x71, the run18
+     * "got unlikely tx max 0 with tx_seq 4" — with byte9 = 0 the DHD's
+     * credit window is negative and the next control TX deadlocks in
+     * dhd_bus_txctl's ctrl_frame_stat wait). The request's seq byte is
+     * the DHD's tx_seq at send time (the DPC's txctl rewrites the frame
+     * to it), so grant seq + 8 like a real dongle would. */
+    s->fn2[base + 9] = (uint8_t)(s->fn2[base + 4] + 8);
+    s->fn2_rd_len = framelen < sizeof(s->fn2_rd) ? framelen
+                                                 : sizeof(s->fn2_rd);
+    memcpy(s->fn2_rd, s->fn2 + base, s->fn2_rd_len);
+    s->fn2_rd_pos = 0;
+    s->ctl_stage = true;
+    x1600_gpio_inject(0, 8, true);              /* WL_HOST_WAKE PA08 */
+}
+
 static void x1600_msc_command(X1600Msc *s)
 {
     uint32_t op = s->regs[MSC_CMD / 4] & 0x3f;
@@ -824,6 +1041,8 @@ static void x1600_msc_command(X1600Msc *s)
             if (c53cnt > sizeof(s->fifo)) {
                 /* larger than the PIO fifo: this can only be the
                  * internal-DMA path (a multi-block transfer) */
+                s->fifo_len = 0;    /* no staged phase: the walk must not
+                                     * false-match the staged-fifo branch */
                 s->dma_pending = true;
                 s->dma_wr = c53wr;
                 s->dma_len = c53cnt;
@@ -857,8 +1076,14 @@ static void x1600_msc_command(X1600Msc *s)
                 s->dma_fn = c53fn;
                 s->dma_addr = c53addr;
                 s->dma_inc = c53inc;
-                /* Do NOT set STAT bit6 (RXFIFO_RDY): the request-fn
-                 * poll spins while bit6 is set (v0.65 inversion). */
+                /* STAT bit6 (RXFIFO_RDY) must stay CLEAR at staging: the
+                 * module's polling READ loop (sg length < 64 -> the word
+                 * loops at request 0x2130-0x22e8) spins while bit6 is SET
+                 * and pops MSC_RXFIFO when CLEAR (v0.86 run15: staging
+                 * bit6 for BLKLEN<64 deadlocked the 4-byte window reads —
+                 * 6.9 GB of STAT re-polls at request+0x6bc until the 3000
+                 * ms timeout, then the guest wedged in the loop). STAT
+                 * bit12 below is what the polling tail waits for. */
                 s->regs[MSC_STAT / 4] |= STAT_XFER_DONE_RD;
                 res = 0;
             } else {
@@ -890,9 +1115,13 @@ static void x1600_msc_command(X1600Msc *s)
     /* per-command status: stale completion bits (esp. TIME_OUT_RES from
      * an earlier no-card scan) must not leak into the next command — the
      * driver turns STAT_TIME_OUT_RES into cmd->error = -ETIMEDOUT, which
-     * reset-looped the whole SDIO enumeration */
+     * reset-looped the whole SDIO enumeration. IFLG bit23/bit31 likewise:
+     * a stale data-done consumed by the thread in the wrong state breaks
+     * the next request's completion (v0.84 run1); bit31 is never acked by
+     * a write's own completion path, so it must be cleared per-command. */
     s->regs[MSC_STAT / 4] &= ~(STAT_END_CMD_RES | STAT_TIME_OUT_RES |
                                (1u << 0) | (1u << 4) | (1u << 5));
+    s->regs[MSC_IFLG / 4] &= ~(IFLG_DATA_DONE | IFLG_DATA_DONE_RD);
     s->regs[MSC_STAT / 4] |= STAT_END_CMD_RES;
     s->res_reads = 0;
     s->res_count = 0;
@@ -921,8 +1150,10 @@ static uint64_t x1600_msc_read(void *opaque, hwaddr addr, unsigned size)
         ret = x1600_msc_res_pop(s);
         s->regs[MSC_RES / 4] = ret;     /* mirror for the REG dump path */
     } else if (addr == MSC_RXFIFO) {
-        /* PIO data phase: soc_msc polls STAT bit6 then pops words. The
-         * FIFO delivers the bytes LSB-first on the wire. */
+        /* PIO data phase: soc_msc's polling READ loop pops words while
+         * STAT bit6 is CLEAR (v0.86 — it spins while bit6 is SET, so the
+         * staging must never raise it). The FIFO delivers the bytes
+         * LSB-first on the wire. */
         unsigned i;
         ret = 0;
         for (i = 0; i < 4; i++) {
@@ -1003,15 +1234,15 @@ static void x1600_msc_write(void *opaque, hwaddr addr,
                 }
                 s->dma_pending = false;
                 if (ok) {
+                    /* polling-mode PIO (v0.84): the request fn polls
+                     * STAT bit13 (polling_status 0x2000), completes the
+                     * request synchronously and acks IFLG bit0/bit1
+                     * itself — it must NOT see an IFLG data-done event
+                     * (the v0.84 run1 leak: a bit23 raised here stayed
+                     * pending, the thread consumed it in state 0 and
