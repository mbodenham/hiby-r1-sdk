 }
 
 static void x1600_intc_class_init(ObjectClass *klass, const void *data)
@@ -335,6 +460,478 @@ static void x1600_intc_register_types(void)
 
 type_init(x1600_intc_register_types)
 
+/* ----------------------------------------------------------------- */
+/* RTC (ingenic,x1600-rtc) — write-protocol model. The vendor driver  */
+/* (ingenic_rtc_writel, 0x80415874) does, per write:                  */
+/*   1. poll +0x00 for bit7 (0x80) "write-ready"                      */
+/*   2. write 0xa55a to +0x3c (write-enable key)                      */
+/*   3. poll +0x3c for bit31 set (write-accepted)                     */
+/*   4. write the value to the target register                        */
+/* A plain persistent stub returns 0 for +0x00 and 0xa55a (positive)  */
+/* for +0x3c, so both polls time out every call and the RTC set-time  */
+/* retry loop spins the CPU in a +0x3c read storm (v0.53 stop: it     */
+/* starved the soc_msc insmod thread). Satisfy the protocol so writes */
+/* complete without timeout.                                          */
+/* ----------------------------------------------------------------- */
+
+typedef struct X1600Rtc {
+    MemoryRegion mmio;
+    uint32_t regs[X1600_RTC_SIZE / 4];
+} X1600Rtc;
+
+static X1600Rtc x1600_rtc_dev;
+
+static uint64_t x1600_rtc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    X1600Rtc *s = opaque;
+    uint64_t ret;
+
+    if (addr == 0x00) {
+        ret = 0x80;                                   /* write-ready */
+    } else if (addr == 0x3c) {
+        ret = s->regs[addr / 4] | 0x80000000u;        /* write-accepted */
+    } else if (addr < sizeof(s->regs)) {
+        ret = s->regs[addr / 4];
+    } else {
+        ret = 0;
+    }
+    return ret;
+}
+
+static void x1600_rtc_write(void *opaque, hwaddr addr,
+                            uint64_t val, unsigned size)
+{
+    X1600Rtc *s = opaque;
+
+    if (addr < sizeof(s->regs)) {
+        s->regs[addr / 4] = val;
+    }
+    qemu_log_mask(LOG_UNIMP, "x1600-rtc write %#llx = %#llx\n",
+                  (unsigned long long)addr, (unsigned long long)val);
+}
+
+static const MemoryRegionOps x1600_rtc_ops = {
+    .read = x1600_rtc_read,
+    .write = x1600_rtc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+/* ----------------------------------------------------------------- */
+/* SFC (ingenic_sfc_v2) + SPI-NAND, M2 model. Register semantics      */
+/* decoded from the vendor driver disassembly + v0.22 stub MMIO log:  */
+/*   0x00 glb ctrl (bit6 = DMA descriptor mode, set when cdt+13!=0)   */
+/*   0x04 cfg / 0x2c total-len / 0x60,0x74,0x78 scratch               */
+/*   0x64 ctrl: bit0 START (W1S), bit1 stop; 0x68 irq status:         */
+/*        bit0/1 error, bit2 RX-fifo, bit3 TX-fifo, bit4 DONE;        */
+/*   0x6c/0x70 write-1-clear on 0x68; 0x7c [5:0]=CDT index,           */
+/*        bit31=has-cmd-phase, bit30=TX(out); 0x80..0x8c params       */
+/*        (feature/page addr at 0x88, value at 0x8c per the log);     */
+/*   0x90 descriptor chain phys (DMA mode); 0x800..0x9ff CDT table    */
+/*        (16B entries, opcode = entry[1].low byte);                  */
+/*   0x1000 PIO data FIFO (word).                                     */
+/* Completion protocol (ingenic_sfc_pio_irq_callback): the handler    */
+/* moves len bytes between the guest buffer and the FIFO (RX: device  */
+/* fills, TX: guest fills), then the device raises DONE; the handler  */
+/* acks via 0x6c/0x70 and complete()s the sync wait. DMA mode walks   */
+/* {next, data, len, more} descriptors in guest memory instead.       */
+/* NAND array: raw page+OOB image (2112 B/page), 64 pages/block,      */
+/* 1024 blocks = 128 MiB data + OOB, mmap'd from nand-r1.bin.         */
+/* ----------------------------------------------------------------- */
+
+#define X1600_SFC_IRQ_LINE  7                    /* DTB /ahb2/sfc <7> */
+#define X1600_SFC_SIZE      0x10000
+#define X1600_NAND_PAGE     2048
+#define X1600_NAND_OOB      64
+#define X1600_NAND_STRIDE   (X1600_NAND_PAGE + X1600_NAND_OOB)
+#define X1600_NAND_PAGES_PER_BLOCK 64
+#define X1600_NAND_BLOCKS   1024
+#define X1600_NAND_BYTES    ((uint64_t)X1600_NAND_STRIDE * \
+                             X1600_NAND_PAGES_PER_BLOCK * X1600_NAND_BLOCKS)
+
+#define SFC_ST_RX    0x04
+#define SFC_ST_TX    0x08
+#define SFC_ST_DONE  0x10
+
+/* target/mips/system/physaddr.c — translate a guest virtual address through
+ * the CPU MMU (kseg0/1/3 + TLB). Declared locally to avoid pulling in
+ * target/mips/internal.h from hw/. */
+extern hwaddr mips_cpu_get_phys_addr_debug(CPUState *cs, vaddr addr);
+
+typedef struct X1600Sfc {
+    MemoryRegion mmio;
+    qemu_irq irq;
+    CPUState *cpu;              /* for DMA descriptor MMU translation */
+    AddressSpace *as;
+    uint8_t *nand;              /* mmap'd backing, X1600_NAND_BYTES */
+    uint32_t regs[0x100 / 4];   /* 0x00..0xff control window */
+    uint32_t cdt[0x200 / 4];    /* 0x800..0x9ff command descriptor table */
+    uint8_t cache[X1600_NAND_STRIDE];
+    uint8_t feature[256];       /* SPI-NAND feature regs (A0/B0/C0) */
+    uint8_t pending;            /* 0x68 status bits */
+    /* fifo/transfer state */
+    uint32_t fifo;              /* one pending fifo word */
+    int fifo_valid;             /* bytes valid in fifo */
+    uint32_t xfer_total;        /* total bytes for this command */
+    uint32_t xfer_done;         /* bytes consumed so far */
+    uint8_t tx_byte;            /* latched TX byte (set_feature value) */
+} X1600Sfc;
+
+static X1600Sfc x1600_sfc_dev;
+
+static void x1600_sfc_irq_raise(X1600Sfc *s, uint8_t bits)
+{
+    s->pending |= bits;
+    qemu_set_irq(s->irq, 1);
+}
+
+static void x1600_sfc_irq_update(X1600Sfc *s)
+{
+    qemu_set_irq(s->irq, s->pending != 0);
+}
+
+static void x1600_sfc_fifo_load(X1600Sfc *s, const uint8_t *data, int len)
+{
+    s->fifo = 0;
+    memcpy(&s->fifo, data, len > 4 ? 4 : len);
+    s->fifo_valid = len;
+    s->xfer_total = len;
+    s->xfer_done = 0;
+    x1600_sfc_irq_raise(s, SFC_ST_RX);
+}
+
+static void x1600_sfc_dma(X1600Sfc *s, uint8_t opcode, bool out);
+
+/* execute one SPI-NAND command; opcode from the CDT entry */
+static void x1600_sfc_exec(X1600Sfc *s, uint8_t opcode)
+{
+    uint32_t addr = s->regs[0x88 / 4];
+    uint64_t off;
+
+    switch (opcode) {
+    case 0xff:                                  /* RESET */
+        x1600_sfc_irq_raise(s, SFC_ST_DONE);
+        break;
+    case 0x9f: {                                /* READ ID: GD5F1GQ4UC */
+        static const uint8_t id[3] = { 0xc8, 0xd1, 0xc8 };
+
+        x1600_sfc_fifo_load(s, id, 3);
+        break;
+    }
+    case 0x1f:                                  /* SET FEATURE (TX, 1B) */
+        s->xfer_total = s->regs[0x2c / 4] ? s->regs[0x2c / 4] : 1;
+        s->xfer_done = 0;
+        x1600_sfc_irq_raise(s, SFC_ST_TX);
+        break;
+    case 0x0f: {                                /* GET FEATURE */
+        uint8_t v = s->feature[addr & 0xff];
+
+        x1600_sfc_fifo_load(s, &v, 1);
+        break;
+    }
+    case 0x13:                                  /* PAGE READ -> cache */
+        /* ROW_ADDR = 0x84, COL_ADDR = 0x80 (vendor dump register names;
+         * v0.27: swapped them and the BBT scan read page 2048's OOB for
+         * every block -> all 1024 blocks marked bad). */
+        off = (uint64_t)s->regs[0x84 / 4] * X1600_NAND_STRIDE;
+        if (off + X1600_NAND_PAGE <= X1600_NAND_BYTES) {
+            memcpy(s->cache, s->nand + off, X1600_NAND_STRIDE);
+        } else {
+            memset(s->cache, 0xff, X1600_NAND_STRIDE);
+        }
+        s->feature[0xc0] &= ~0x01;              /* OIP clear */
+        if (s->regs[0] & 0x40) {                /* DMA mode: page load +
+                                                 * cache read in one op */
+            x1600_sfc_dma(s, opcode, false);
+        } else {
+            x1600_sfc_irq_raise(s, SFC_ST_DONE);
+        }
+        break;
+    case 0xd8:                                  /* BLOCK ERASE */
+        off = (uint64_t)(addr & ~(X1600_NAND_PAGES_PER_BLOCK - 1)) *
+              X1600_NAND_STRIDE;
+        if (off < X1600_NAND_BYTES) {
+            memset(s->nand + off, 0xff,
+                   X1600_NAND_STRIDE * X1600_NAND_PAGES_PER_BLOCK);
+        }
+        s->feature[0xc0] &= ~0x01;
+        x1600_sfc_irq_raise(s, SFC_ST_DONE);
+        break;
+    case 0x10:                                  /* PROGRAM EXECUTE */
+        off = (uint64_t)addr * X1600_NAND_STRIDE;
+        if (off + X1600_NAND_PAGE <= X1600_NAND_BYTES) {
+            uint32_t i;
+
+            for (i = 0; i < X1600_NAND_STRIDE; i++) {
+                s->nand[off + i] &= s->cache[i];   /* NAND: 1 -> 0 only */
+            }
+        }
+        s->feature[0xc0] &= ~0x01;
+        x1600_sfc_irq_raise(s, SFC_ST_DONE);
+        break;
+    default:
+        /* READ CACHE (0x03/0x0b/0x6b/0xeb) and PROGRAM LOAD
+         * (0x02/0x84/0x32/0x34) take the DMA-descriptor path; they are
+         * driven by x1600_sfc_dma() on START, not here. */
+        qemu_log_mask(LOG_UNIMP, "x1600-sfc: unhandled opcode %#x\n", opcode);
+        x1600_sfc_irq_raise(s, SFC_ST_DONE);
+        break;
+    }
+}
+
+/* DMA-descriptor transfer for READ CACHE / PROGRAM LOAD */
+/* The driver stores the DMA descriptor base in 0x90 as a guest VIRTUAL
+ * address (desc_area_va + 0x80000000). Translate through the CPU MMU to the
+ * physical address before reading the descriptor chain. The chain's own
+ * next/mem fields were already virt_to_phys'd by the driver (sfc_get_paddr),
+ * so they are used as physical. */
+static uint32_t x1600_sfc_desc_base(X1600Sfc *s)
+{
+    uint32_t raw = s->regs[0x90 / 4];
+    hwaddr mmu = mips_cpu_get_phys_addr_debug(s->cpu, raw);
+    uint32_t kseg1 = (raw >= 0x20000000 && raw < 0x40000000) ?
+                     raw - 0x20000000 : raw;
+
+    static int dbg = 3;
+    if (dbg-- > 0) {
+        uint32_t a[4] = {0}, b[4] = {0}, c[4] = {0};
+        int ra = dma_memory_read(&address_space_memory, raw, a, 16,
+                                 MEMTXATTRS_UNSPECIFIED);
+        int rb = dma_memory_read(&address_space_memory, kseg1, b, 16,
+                                 MEMTXATTRS_UNSPECIFIED);
+        int rc = (mmu != (hwaddr)-1) ?
+                 dma_memory_read(&address_space_memory, mmu, c, 16,
+                                 MEMTXATTRS_UNSPECIFIED) : 99;
+        qemu_log_mask(LOG_UNIMP,
+                      "x1600-sfc: desc probe raw=%#x(kseg0/1? ret=%d "
+                      "mem=%#x len=%#x) kseg1=%#x(ret=%d mem=%#x len=%#x) "
+                      "mmu=%#llx(ret=%d mem=%#x len=%#x)\n",
+                      raw, ra, a[1], a[2], kseg1, rb, b[1], b[2],
+                      (unsigned long long)mmu, rc, c[1], c[2]);
+    }
+    /* Prefer the kseg1-offset physical base (descriptor area is cached
+     * kseg1); it is what the driver's `desc_va + 0x80000000` reduces to. */
+    return kseg1;
+}
+
+static void x1600_sfc_dma(X1600Sfc *s, uint8_t opcode, bool out)
+{
+    uint32_t desc = x1600_sfc_desc_base(s);
+    uint32_t col = s->regs[0x80 / 4];   /* COL_ADDR; OOB cols (>= 2048)
+                                         * are legal — bad-block markers */
+    int guard = 0;
+    static int dbg = 12;
+
+    if (dbg > 0) {
+        uint32_t d[4] = {0};
+
+        dbg--;
+        if (dma_memory_read(&address_space_memory, desc, d, sizeof(d),
+                            MEMTXATTRS_UNSPECIFIED) == MEMTX_OK) {
+            qemu_log_mask(LOG_UNIMP,
+                          "x1600-sfc dma: op=%#x out=%d col=%#x base=%#x"
+                          " desc={next=%#x,mem=%#x,len=%#x,more=%#x}\n",
+                          opcode, out, col, s->regs[0x90 / 4],
+                          d[0], d[1], d[2], d[3]);
+        } else {
+            qemu_log_mask(LOG_UNIMP,
+                          "x1600-sfc dma: op=%#x base=%#x UNMAPPED\n",
+                          opcode, s->regs[0x90 / 4]);
+        }
+    }
+
+    while (desc && guard++ < 64) {
+        uint32_t d[4], len;
+        uint64_t addr;
+
+        if (dma_memory_read(&address_space_memory, desc, d, sizeof(d),
+                            MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+            break;
+        }
+        len = d[2];
+        if (len > X1600_NAND_STRIDE) {
+            len = X1600_NAND_STRIDE;
+        }
+        for (addr = 0; addr < len; addr++) {
+            if (out) {
+                uint8_t b;
+
+                if (dma_memory_read(&address_space_memory, d[1] + addr,
+                                    &b, 1, MEMTXATTRS_UNSPECIFIED)
+                    != MEMTX_OK) {
+                    break;
+                }
+                if (col < X1600_NAND_STRIDE) {
+                    s->cache[col++] = b;
+                }
+            } else {
+                uint8_t b = col < X1600_NAND_STRIDE ? s->cache[col++] : 0xff;
+
+                if (dma_memory_write(&address_space_memory, d[1] + addr,
+                                     &b, 1, MEMTXATTRS_UNSPECIFIED)
+                    != MEMTX_OK) {
+                    break;
+                }
+            }
+        }
+        if (!d[0]) {
+            break;
+        }
+        desc = d[0];
+    }
+    x1600_sfc_irq_raise(s, SFC_ST_DONE);
+}
+
+static bool x1600_sfc_opcode_is_dma(uint8_t opcode)
+{
+    switch (opcode) {
+    case 0x03: case 0x0b: case 0x6b: case 0xeb:   /* READ CACHE variants */
+    case 0x02: case 0x84: case 0x32: case 0x34:   /* PROGRAM LOAD variants */
+        return true;
+    }
+    return false;
+}
+
+static bool x1600_sfc_opcode_is_out(uint8_t opcode)
+{
+    switch (opcode) {
+    case 0x02: case 0x84: case 0x32: case 0x34:
+    case 0x1f:
+        return true;
+    }
+    return false;
+}
+
+static void x1600_sfc_start(X1600Sfc *s)
+{
+    uint32_t idx = s->regs[0x7c / 4] & 0x3f;
+    uint8_t opcode = s->cdt[idx * 4 + 1] & 0xff;
+
+    qemu_log_mask(LOG_UNIMP,
+                  "x1600-sfc: START cdt=%u opcode=%#x p80=%#x p84=%#x "
+                  "p88=%#x p8c=%#x len=%#x dma=%d\n",
+                  idx, opcode, s->regs[0x80 / 4], s->regs[0x84 / 4],
+                  s->regs[0x88 / 4], s->regs[0x8c / 4], s->regs[0x2c / 4],
+                  !!(s->regs[0] & 0x40));
+    if (x1600_sfc_opcode_is_dma(opcode)) {
+        x1600_sfc_dma(s, opcode, x1600_sfc_opcode_is_out(opcode));
+    } else {
+        x1600_sfc_exec(s, opcode);
+    }
+}
+
+static uint64_t x1600_sfc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    X1600Sfc *s = opaque;
+    uint64_t ret;
+
+    if (addr == 0x68) {
+        ret = s->pending;
+    } else if (addr == 0x1000) {           /* PIO FIFO pop */
+        ret = s->fifo;
+        s->xfer_done += 4;
+        if (s->xfer_done >= s->xfer_total) {
+            s->pending &= ~SFC_ST_RX;
+            x1600_sfc_irq_raise(s, SFC_ST_DONE);
+        }
+        qemu_log_mask(LOG_UNIMP, "x1600-sfc fifo pop = %#llx\n",
+                      (unsigned long long)ret);
+        return ret;
+    } else if (addr < 0x100) {
+        ret = s->regs[addr / 4];
+    } else if (addr >= 0x800 && addr < 0xa00) {
+        ret = s->cdt[(addr - 0x800) / 4];
+    } else {
+        ret = 0;
+    }
+    qemu_log_mask(LOG_UNIMP, "x1600-sfc read %#llx = %#llx\n",
+                  (unsigned long long)addr, (unsigned long long)ret);
+    return ret;
+}
+
+static void x1600_sfc_write(void *opaque, hwaddr addr,
+                            uint64_t val, unsigned size)
+{
+    X1600Sfc *s = opaque;
+
+    qemu_log_mask(LOG_UNIMP, "x1600-sfc write %#llx = %#llx\n",
+                  (unsigned long long)addr, (unsigned long long)val);
+    if (addr == 0x64) {
+        /* SFC_TRIG: bit0 START self-clears when the transfer completes;
+         * our execution is synchronous so bit0 never reads back set.
+         * (v0.25: edge-detect broke back-to-back transfers — the driver
+         * writes 3 for every transfer without an intervening stop.) */
+        s->regs[addr / 4] = val & ~1u;
+        if (val & 1) {
+            x1600_sfc_start(s);
+        }
+        return;
+    }
+    if (addr == 0x6c || addr == 0x70) {      /* write-1-clear status */
+        s->pending &= ~(uint8_t)val;
+        x1600_sfc_irq_update(s);
+        return;
+    }
+    if (addr == 0x1000) {                    /* PIO FIFO push (TX) */
+        s->tx_byte = val & 0xff;
+        s->xfer_done += 4;
+        if (s->xfer_done >= s->xfer_total) {
+            uint32_t idx = s->regs[0x7c / 4] & 0x3f;
+            uint8_t opcode = s->cdt[idx * 4 + 1] & 0xff;
+
+            s->pending &= ~SFC_ST_TX;
+            if (opcode == 0x1f) {
+                s->feature[s->regs[0x88 / 4] & 0xff] = s->tx_byte;
+            }
+            x1600_sfc_irq_raise(s, SFC_ST_DONE);
+        }
+        return;
+    }
+    if (addr < 0x100) {
+        s->regs[addr / 4] = val;
+    } else if (addr >= 0x800 && addr < 0xa00) {
+        s->cdt[(addr - 0x800) / 4] = val;
+    }
+}
+
+static const MemoryRegionOps x1600_sfc_ops = {
+    .read = x1600_sfc_read,
+    .write = x1600_sfc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void x1600_sfc_init(X1600Sfc *s, const char *image_path)
+{
+    int fd = open(image_path, O_RDWR | O_CREAT, 0644);
+    struct stat st;
+
+    if (fd < 0) {
+        error_report("x1600: cannot open NAND image %s", image_path);
+        exit(1);
+    }
+    if (fstat(fd, &st) == 0 && st.st_size != (off_t)X1600_NAND_BYTES) {
+        if (ftruncate(fd, X1600_NAND_BYTES) != 0) {
+            error_report("x1600: cannot size NAND image %s", image_path);
+            exit(1);
+        }
+    }
+    s->nand = mmap(NULL, X1600_NAND_BYTES, PROT_READ | PROT_WRITE,
+                   MAP_SHARED, fd, 0);
+    if (s->nand == MAP_FAILED) {
+        error_report("x1600: cannot mmap NAND image %s", image_path);
+        exit(1);
+    }
+    if (st.st_size == 0) {
+        memset(s->nand, 0xff, X1600_NAND_BYTES);   /* erased state */
+    }
+    close(fd);
+    s->feature[0xa0] = 0;      /* block-lock: all unlocked (driver also
+                                 * writes 0 explicitly via SET FEATURE) */
+}
