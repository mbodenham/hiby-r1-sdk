 /* ----------------------------------------------------------------- */
-/* INTC stub: regfile that reads zero; IRQ inputs are latched only    */
-/* (real delivery comes when the boot trace demands it).             */
+/* CGU (clock generator unit) — persistent regfile (vendor kernel RMWs
+ * PLL/gate blocks; read-back is the minimum correct semantics, v0.18)
+ * plus one modelled status: +0x2c (PLL status) reads all-locked. The
+ * clock framework's enable path polls +0x2c for the lock bit after
+ * programming +0x24; the all-zero stub made soc_msc's init retry the
+ * clock enable forever (v0.59 stop: thousands of +0x2c/+0 polls with
+ * no other activity while insmod(soc_msc) hung). Real X1600 locks the
+ * PLL in ~us; advertising lock is faithful for a boot model.          */
+/* ----------------------------------------------------------------- */
+
+typedef struct X1600Cgu {
+    MemoryRegion mmio;
+    uint32_t regs[0x100 / 4];
+} X1600Cgu;
+
+static X1600Cgu x1600_cgu_dev;
+
+static uint64_t x1600_cgu_read(void *opaque, hwaddr addr, unsigned size)
+{
+    X1600Cgu *s = opaque;
+
+    if (addr == 0x2c) {
+        return 0xffffffff;
+    }
+    if (addr < sizeof(s->regs)) {
+        qemu_log_mask(LOG_UNIMP, "x1600-cgu read %#llx = %#llx\n",
+                      (unsigned long long)addr,
+                      (unsigned long long)s->regs[addr / 4]);
+        return s->regs[addr / 4];
+    }
+    return 0;
+}
+
+static void x1600_cgu_write(void *opaque, hwaddr addr,
+                            uint64_t val, unsigned size)
+{
+    X1600Cgu *s = opaque;
+
+    if (addr >= sizeof(s->regs)) {
+        return;
+    }
+    s->regs[addr / 4] = val;
+    qemu_log_mask(LOG_UNIMP, "x1600-cgu write %#llx = %#llx\n",
+                  (unsigned long long)addr, (unsigned long long)val);
+}
+
+static const MemoryRegionOps x1600_cgu_ops = {
+    .read = x1600_cgu_read,
+    .write = x1600_cgu_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+/* ----------------------------------------------------------------- */
+/* INTC: jz4780-style interrupt controller (ingenic,ingenic-intc).    */
+/* Two 32-line banks, stride 0x20: ISR+0x00, IMR+0x04, IMSR+0x08,     */
+/* IMCR+0x0C, IPR+0x10. IMR resets all-masked; IPR = ISR & ~IMR; the  */
+/* output line (wired to CPU IRQ 2 per the stock DTB core-intc node)  */
+/* asserts while any IPR bit is set. Level-triggered inputs.          */
+/* Model pinned by: v0.18 IMCR writes (OTG line 1, PDMA/MCU 3/4/5),   */
+/* M2 SFC command completion on line 7.                               */
 /* ----------------------------------------------------------------- */
 
 #define TYPE_X1600_INTC "x1600-intc"
@@ -236,7 +303,76 @@ OBJECT_DECLARE_SIMPLE_TYPE(X1600Intc, X1600_INTC)
 struct X1600Intc {
     SysBusDevice parent_obj;
     MemoryRegion mmio;
-    uint32_t latch;
+    qemu_irq out;
+    uint32_t isr[2];    /* raw line levels */
+    uint32_t imr[2];    /* mask, 1 = masked */
+};
+
+static void x1600_intc_update(X1600Intc *s)
+{
+    uint32_t ipr = (s->isr[0] & ~s->imr[0]) | (s->isr[1] & ~s->imr[1]);
+
+    qemu_set_irq(s->out, ipr != 0);
+}
+
+static void x1600_intc_set_irq(void *opaque, int irq, int level)
+{
+    X1600Intc *s = X1600_INTC(opaque);
+    uint32_t mask = 1u << (irq & 31);
+
+    if (level) {
+        s->isr[irq >> 5] |= mask;
+    } else {
+        s->isr[irq >> 5] &= ~mask;
+    }
+    x1600_intc_update(s);
+}
+
+static uint64_t x1600_intc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    X1600Intc *s = X1600_INTC(opaque);
+    int bank = (addr >> 5) & 1;
+    uint64_t ret;
+
+    switch (addr & 0x1f) {
+    case 0x00:  ret = s->isr[bank]; break;
+    case 0x04:  ret = s->imr[bank]; break;
+    case 0x10:  ret = s->isr[bank] & ~s->imr[bank]; break;
+    default:    ret = 0; break;
+    }
+    qemu_log_mask(LOG_UNIMP, "x1600-intc read %#llx = %#llx\n",
+                  (unsigned long long)addr, (unsigned long long)ret);
+    return ret;
+}
+
+static void x1600_intc_write(void *opaque, hwaddr addr,
+                             uint64_t val, unsigned size)
+{
+    X1600Intc *s = X1600_INTC(opaque);
+    int bank = (addr >> 5) & 1;
+
+    qemu_log_mask(LOG_UNIMP, "x1600-intc write %#llx = %#llx\n",
+                  (unsigned long long)addr, (unsigned long long)val);
+    switch (addr & 0x1f) {
+    case 0x04:
+        s->imr[bank] = val;
+        break;
+    case 0x08:              /* IMSR: set mask bits */
+        s->imr[bank] |= val;
+        break;
+    case 0x0c:              /* IMCR: clear mask bits */
+        s->imr[bank] &= ~val;
+        break;
+    }
+    x1600_intc_update(s);
+}
+
+static const MemoryRegionOps x1600_intc_ops = {
+    .read = x1600_intc_read,
+    .write = x1600_intc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
 };
 
