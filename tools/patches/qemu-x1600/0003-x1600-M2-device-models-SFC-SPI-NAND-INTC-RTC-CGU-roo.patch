-    memory_region_init_io(&s->mmio, OBJECT(s), &x1600_stub_ops,
-                          stub, "x1600-intc", X1600_INTC_SIZE);
+    s->imr[0] = s->imr[1] = 0xffffffff;   /* hardware reset: all masked */
+    memory_region_init_io(&s->mmio, OBJECT(s), &x1600_intc_ops,
+                          s, "x1600-intc", X1600_INTC_SIZE);
     sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->mmio);
-    qdev_init_gpio_in(dev, x1600_stub_set_irq, 64);
+    qdev_init_gpio_in(dev, x1600_intc_set_irq, 64);
