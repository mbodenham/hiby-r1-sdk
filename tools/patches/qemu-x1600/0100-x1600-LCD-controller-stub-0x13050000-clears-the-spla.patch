From: Matthew Bodenham <matthew@bodenham.me>
Date: Tue, 13 Oct 2026 17:13:08 +0900
Subject: [PATCH 100/104] =?UTF-8?q?x1600:=20LCD=20controller=20stub=20(0x1?=
 =?UTF-8?q?3050000)=20=E2=80=94=20clears=20the=20splash=20oops?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The v0.63-v0.65 'JPEG block' 0x13050000 is the LCD controller (DPU);
cmd_jpeg_display is pure userland (libhardware2 fb ioctls on /dev/fb0,
zero MMIO) and the splash oops was soc_fb.ko (jzfb) bus-erroring inside
jzfb_blank on this unmapped block on behalf of the splash
('Data bus error, epc == ... jzfb_blank+0x4ac [soc_fb]', Code:
3c03b305 <ac64200c> = sw a2,0x200c(0xb3050000)).

Model: persistent regfile over 0x10000 (covers +0xa018 and +0x2010)
with the three load-bearing soc_fb semantics:
- +0xa018 bit0 = SLCD BUSY reads 0 (slcd_wait_busy_us polls it with
  500us sleeps; self-clears on write)
- +0x1004 write 1 (frame kick after the descriptor store at +0x1000):
  STATE +0x2010 |= EOF bit17, raise the frame-done IRQ
- +0x2008 write = W1C of STATE (jzfb_irq_handler); IRQ = INTC input 31
  (request_threaded_irq(39) - 8, same hwirq arithmetic as SADC 11->19)
pan_display_sync=1 makes FBIOPAN_DISPLAY wait on state==2, so without
the IRQ every frame stalls ~100 s then errors; the IRQ is mandatory.

Verified by boot: the splash oops (jzfb_blank DBE at 5.0 s) is gone.
---
 hw/mips/x1600.c | 92 +++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 92 insertions(+)

diff --git a/hw/mips/x1600.c b/hw/mips/x1600.c
index 4737f0f..47316e9 100644
--- a/hw/mips/x1600.c
+++ b/hw/mips/x1600.c
@@ -111,6 +111,17 @@
  * 0x10070000 (v0.63 boot) -- same leaked-mutex cascade as i2c/aic. */
 #define X1600_SADC_BASE    0x10070000
 #define X1600_SADC_SIZE    0x1000
+/* LCD controller (0x13050000): the v0.63-v0.65 "JPEG block" -- a misnomer.
+ * cmd_jpeg_display is pure userland (libhardware2 fb ioctls on /dev/fb0,
+ * zero MMIO); the splash oops was soc_fb.ko (jzfb) bus-erroring inside
+ * jzfb_blank on this unmapped block on behalf of the splash (v0.63-65
+ * boots: "Data bus error, epc == ... jzfb_blank+0x4ac [soc_fb]", Code:
+ * 3c03b305 <ac64200c> = sw a2,0x200c(x0b3050000)). soc_fb registers the
+ * frame-done IRQ with request_threaded_irq(39) -> INTC input 31
+ * (hwirq = virq - 8, same arithmetic as the SADC's 11 -> virq 19). */
+#define X1600_LCD_BASE     0x13050000
+#define X1600_LCD_SIZE     0x10000
+#define X1600_LCD_IRQ_LINE 31
 #define X1600_SFC_BASE     0x13440000            /* /ahb2/sfc (ingenic,x1600-sfc):
                             * SPI flash controller; v0.21 bus error in
                             * sfc_clk_set_init RMW of +4 (clock divider). */
@@ -881,6 +892,79 @@ static const MemoryRegionOps x1600_rtc_ops = {
     .valid.max_access_size = 4,
 };
 
+/* ----------------------------------------------------------------- */
+/* LCD controller (0x13050000, size 0x10000) — minimal model (v0.66).  */
+/* Persistent regfile (the jzfb RMW surface: dense 0x00-0xfc cfg/      */
+/* timing regs, descriptors 0x220/0x230-0x244, +0x1000/+0x1004, the    */
+/* int/state block +0x2000-0x2014, the SLCD panel-SPI window           */
+/* +0xa000-0xa018) plus three load-bearing semantics from soc_fb.ko:   */
+/*   +0xa018 bit0 = SLCD BUSY: slcd_wait_busy_us polls it with 500 us  */
+/*        sleeps — must read 0 (self-clears on write; we are instant). */
+/*   +0x1004 = frame kick: lcdc_pan_display stores the frame           */
+/*        descriptor pointer at +0x1000 then writes 1 here; the model  */
+/*        sets STATE (+0x2010) bit17 (EOF) and raises the frame-done   */
+/*        IRQ.                                                         */
+/*   +0x2008 = IRQ clear (W1C of STATE): jzfb_irq_handler reads        */
+/*        +0x2010, W1Cs +0x2008 (0x20000 on EOF) and wakes pan_display */
+/*        — pan_display_sync=1 makes FBIOPAN_DISPLAY wait on state==2, */
+/*        so without the IRQ every frame stalls ~100 s then errors.    */
+/* IRQ = INTC input 31 (request_threaded_irq(39) - 8).                 */
+/* ----------------------------------------------------------------- */
+
+typedef struct X1600Lcd {
+    MemoryRegion mmio;
+    qemu_irq irq;
+    uint32_t regs[X1600_LCD_SIZE / 4];
+} X1600Lcd;
+
+static X1600Lcd x1600_lcd_dev;
+
+static void x1600_lcd_update_irq(X1600Lcd *s)
+{
+    qemu_set_irq(s->irq, (s->regs[0x2010 / 4] & 0x20000u) != 0);
+}
+
+static uint64_t x1600_lcd_read(void *opaque, hwaddr addr, unsigned size)
+{
+    X1600Lcd *s = opaque;
+    uint64_t ret = (addr < X1600_LCD_SIZE) ? s->regs[addr / 4] : 0;
+
+    if (addr == 0xa018) {
+        ret &= ~1u;                     /* SLCD BUSY: never busy */
+    }
+    return ret;
+}
+
+static void x1600_lcd_write(void *opaque, hwaddr addr,
+                            uint64_t val, unsigned size)
+{
+    X1600Lcd *s = opaque;
+
+    if (addr >= X1600_LCD_SIZE) {
+        return;
+    }
+    if (addr == 0xa018) {
+        val &= ~1u;                     /* BUSY self-clears instantly */
+    }
+    s->regs[addr / 4] = val;
+    if (addr == 0x1004 && (val & 1)) {
+        /* frame kick: descriptor stored at +0x1000, EOF latches */
+        s->regs[0x2010 / 4] |= 0x20000u;
+        x1600_lcd_update_irq(s);
+    } else if (addr == 0x2008) {
+        s->regs[0x2010 / 4] &= ~val;    /* W1C of STATE */
+        x1600_lcd_update_irq(s);
+    }
+}
+
+static const MemoryRegionOps x1600_lcd_ops = {
+    .read = x1600_lcd_read,
+    .write = x1600_lcd_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
 /* ----------------------------------------------------------------- */
 /* SFC (ingenic_sfc_v2) + SPI-NAND, M2 model. Register semantics      */
 /* decoded from the vendor driver disassembly + v0.22 stub MMIO log:  */
@@ -1426,6 +1510,14 @@ static void x1600_mach_init(MachineState *ms)
     x1600_add_stub(sysmem, "x1600-i2c2",     X1600_I2C2_BASE,    X1600_I2C_SIZE);
     x1600_add_stub(sysmem, "x1600-aic",      X1600_AIC_BASE,     X1600_AIC_SIZE);
 
+    /* LCD controller 0x13050000 (the "JPEG block"): persistent regfile
+     * + kick->EOF + frame-done IRQ on INTC 31 — clears the splash oops
+     * (jzfb_blank bus error) and the FBIOPAN_DISPLAY 100 s stall. */
+    x1600_lcd_dev.irq = qdev_get_gpio_in(intc, X1600_LCD_IRQ_LINE);
+    memory_region_init_io(&x1600_lcd_dev.mmio, NULL, &x1600_lcd_ops,
+                          &x1600_lcd_dev, "x1600.lcd", X1600_LCD_SIZE);
+    memory_region_add_subregion(sysmem, X1600_LCD_BASE, &x1600_lcd_dev.mmio);
+
     /* SFC + SPI-NAND (M2): command engine backed by the raw page+OOB
      * image next to the kernel (built by tools/tierc/make_nand_image.py);
      * IRQ on INTC line 7 (stock DTB). */
