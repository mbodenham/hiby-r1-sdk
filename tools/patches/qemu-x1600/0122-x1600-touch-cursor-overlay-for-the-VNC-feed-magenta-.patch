From ce520734a3db31e6935c60655a7669e4e5b57fcf Mon Sep 17 00:00:00 2001
From: Matthew Bodenham <matthew@bodenham.me>
Date: Thu, 15 Oct 2026 10:40:45 +0900
Subject: [PATCH] x1600: touch-cursor overlay for the VNC feed (magenta
 crosshair at the pointer)

---
 hw/mips/x1600.c | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/hw/mips/x1600.c b/hw/mips/x1600.c
index c214590..e540a36 100644
--- a/hw/mips/x1600.c
+++ b/hw/mips/x1600.c
@@ -2834,6 +2834,11 @@ void x1600_i2c_touch_report(bool touched, unsigned x, unsigned y)
 /* panel; left button = the touch down/up.                             */
 /* ----------------------------------------------------------------- */
 
+/* Touch-cursor overlay state: the VNC pointer position in panel coords,
+ * drawn as a crosshair into the fb copy at display-refresh time. */
+static int x1600_cursor_x, x1600_cursor_y;
+static bool x1600_cursor_seen;
+
 static void x1600_input_event(DeviceState *dev, QemuConsole *src,
                               QemuInputEvent *evt)
 {
@@ -2863,6 +2868,7 @@ static void x1600_input_event(DeviceState *dev, QemuConsole *src,
         if (evt->btn.button == INPUT_BUTTON_LEFT) {
             X1600I2c *t = &x1600_i2c1_dev;
 
+            x1600_cursor_seen = true;
             x1600_i2c_touch_report(evt->btn.down, t->x, t->y);
         }
         break;
@@ -2870,9 +2876,13 @@ static void x1600_input_event(DeviceState *dev, QemuConsole *src,
         switch (evt->abs.axis) {
         case INPUT_AXIS_X:
             x1600_i2c1_dev.x = ((uint64_t)evt->abs.value * 480) >> 15;
+            x1600_cursor_x = x1600_i2c1_dev.x;
+            x1600_cursor_seen = true;
             break;
         case INPUT_AXIS_Y:
             x1600_i2c1_dev.y = ((uint64_t)evt->abs.value * 800) >> 15;
+            x1600_cursor_y = x1600_i2c1_dev.y;
+            x1600_cursor_seen = true;
             break;
         default:
             break;
@@ -3065,6 +3075,40 @@ static void x1600_lcd_fb_draw(X1600Lcd *s)
                         X1600_FB_BYTES, MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
         return;
     }
+    if (x1600_cursor_seen) {
+        /* touch-cursor overlay: an 11 px magenta crosshair at the VNC
+         * pointer position with a 1 px black outline, so every VNC
+         * client shows where a click lands (QEMU sends no cursor
+         * shape for this console). fb_copy is RGB565, stride 960 B. */
+        int cx = x1600_cursor_x, cy = x1600_cursor_y, d;
+        if (cx < 0) cx = 0;
+        if (cx > X1600_FB_WIDTH - 1) cx = X1600_FB_WIDTH - 1;
+        if (cy < 0) cy = 0;
+        if (cy > X1600_FB_HEIGHT - 1) cy = X1600_FB_HEIGHT - 1;
+        for (d = -6; d <= 6; d++) {
+            uint16_t *row = (uint16_t *)(s->fb_copy + cy * X1600_FB_STRIDE);
+            uint16_t *col;
+            int px = cx + d, py = cy + d;
+            if (px >= 0 && px < X1600_FB_WIDTH) {
+                uint16_t *p = row + px;
+                if (d != 0) {
+                    *p = 0xf81f;
+                }
+                if (abs(d) == 6) {          /* arm tips: black caps */
+                    *p = 0x0000;
+                }
+            }
+            if (py >= 0 && py < X1600_FB_HEIGHT) {
+                col = (uint16_t *)(s->fb_copy + py * X1600_FB_STRIDE) + cx;
+                if (d != 0) {
+                    *col = 0xf81f;
+                }
+                if (abs(d) == 6) {
+                    *col = 0x0000;
+                }
+            }
+        }
+    }
     if (!s->ds) {
         /* 16 bpp RGB565 surface over the host copy; guest and host are
          * both little-endian, so the upload above is a plain row copy. */
-- 
