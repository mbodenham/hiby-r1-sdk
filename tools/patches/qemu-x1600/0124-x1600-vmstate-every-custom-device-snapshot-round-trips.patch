+ * DHD's readframes continuation), the 32 KB backplane windows with
+ * their SBADDR keys, and the delayed PA08 re-kick timer deadline. The
+ * IRQ line is recomputed in post_load (level from IFLG & ~IMASK). */
+static const VMStateDescription x1600_msc_vmstate = {
+    .name = "x1600-msc",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = x1600_msc_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_TIMER_PTR(pa08_rekick, X1600Msc),
+        VMSTATE_UINT32_ARRAY(regs, X1600Msc, 0x100 / 4),
+        VMSTATE_UINT16(rca, X1600Msc),
+        VMSTATE_UINT8_ARRAY(cccr, X1600Msc, sizeof_field(X1600Msc, cccr)),
+        VMSTATE_UINT8_ARRAY(cis, X1600Msc, sizeof_field(X1600Msc, cis)),
+        VMSTATE_UINT8_ARRAY(fn1, X1600Msc, sizeof_field(X1600Msc, fn1)),
+        VMSTATE_UINT8_ARRAY(fn2, X1600Msc, sizeof_field(X1600Msc, fn2)),
+        VMSTATE_BOOL(ctl_stage, X1600Msc),
+        VMSTATE_UINT8_ARRAY(fn2_rd, X1600Msc,
+                            sizeof_field(X1600Msc, fn2_rd)),
+        VMSTATE_UINT32(fn2_rd_len, X1600Msc),
+        VMSTATE_UINT32(fn2_rd_pos, X1600Msc),
+        VMSTATE_UINT8_ARRAY(fifo, X1600Msc, sizeof_field(X1600Msc, fifo)),
+        VMSTATE_UINT32(fifo_len, X1600Msc),
+        VMSTATE_UINT32(fifo_pos, X1600Msc),
+        VMSTATE_BOOL(dma_pending, X1600Msc),
+        VMSTATE_BOOL(dma_wr, X1600Msc),
+        VMSTATE_BOOL(dma_inc, X1600Msc),
+        VMSTATE_UINT32(dma_len, X1600Msc),
+        VMSTATE_UINT32(dma_fn, X1600Msc),
+        VMSTATE_UINT32(dma_addr, X1600Msc),
+        VMSTATE_BUFFER_UNSAFE(bp_windows, X1600Msc, 1,
+                              16 * 0x8000),
+        VMSTATE_UINT32_ARRAY(bp_keys, X1600Msc, 16),
+        VMSTATE_UINT32(res_reads, X1600Msc),
+        VMSTATE_UINT32(res_count, X1600Msc),
+        VMSTATE_UINT8_ARRAY(res_bytes, X1600Msc,
+                            sizeof_field(X1600Msc, res_bytes)),
+        VMSTATE_END_OF_LIST()
+    },
+};
