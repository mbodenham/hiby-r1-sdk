     .valid.max_access_size = 4,
 };
 
+/* Snapshot state (v0.89): the regfile, the last compare reload value and
+ * the armed deadline. The free-running counter at +0x20/+0x24 derives from
+ * QEMU_CLOCK_VIRTUAL, which the migration stream itself re-bases, so only
+ * the clockevent state is saved here; the timer load re-arms it. */
+static const VMStateDescription x1600_ost_vmstate = {
+    .name = "x1600-ost",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_TIMER_PTR(t, X1600Ost),
+        VMSTATE_UINT32_ARRAY(regs, X1600Ost, X1600_OST_SIZE / 4),
+        VMSTATE_UINT32(period, X1600Ost),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
 /* TCSM0 vendor block (unsized in the stock DTB; used by plat_mem_setup +
  * PM: tcpu_resume/tcpu_sleep/tload_func_to_tcsm park resume code and the
  * fw-DTB pointer at +0x244 here). On silicon it is on-chip SRAM, never a
@@ -377,6 +394,20 @@ static const MemoryRegionOps x1600_cgu_ops = {
     .valid.max_access_size = 4,
 };
 
+/* Snapshot state (v0.89): the seeded/programmed clock regfile plus the
+ * CE-trigger "written" bitmap (reads of a self-cleared trigger offset
