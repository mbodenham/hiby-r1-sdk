 /* ----------------------------------------------------------------- */
 /* MSC (MMC/SD/SDIO host, jzmmc_v12 layout — register defines cross-   */
 /* checked against the Ingenic X1000 SDK's drivers/mmc/host/jzmmc_v12  */
@@ -499,13 +530,14 @@ typedef struct X1600Msc {
     unsigned dma_len;
     unsigned dma_fn;
     uint32_t dma_addr;
-    uint8_t *bp_chunks[16];     /* backplane window content, one 32 KB
-                                 * chunk per SBADDR key (the BCM window
-                                 * = 32 KB at (SBADDR<<8) & ~0x7fff);
-                                 * chunk key = target >> 15. The DHD's
-                                 * ai_scan for 0xa9a6 uses static core
-                                 * tables, so only chipcommon (0x18000000)
-                                 * has meaningful content so far. */
+    /* backplane window content, one 32 KB chunk per SBADDR key (the BCM
+     * window = 32 KB at (SBADDR<<8) & ~0x7fff); chunk key =
+     * target >> 15. The DHD's ai_scan for 0xa9a6 uses static core
+     * tables, so only chipcommon (0x18000000) has meaningful content
+     * so far. Stored INLINE (v0.89, snapshot state): the windows are
+     * zero-filled at claim time exactly like the old g_malloc0 chunks,
+     * keyed by bp_keys[] (X1600_MSC_BP_FREE = unclaimed slot). */
+    uint8_t bp_windows[16][0x8000];
     uint32_t bp_keys[16];
     unsigned res_reads;         /* RES byte-window state, see res_pop */
     unsigned res_count;
@@ -551,21 +583,26 @@ static void x1600_msc_update_irq(X1600Msc *s)
 
 /* Backplane window chunk lookup/create: the 32 KB bank at fn1
  * 0x8000-0xffff maps (SBADDR << 8) | (addr & 0x7fff) to a cached chunk
- * keyed by the backplane address >> 15. */
+ * keyed by the backplane address >> 15. Unclaimed slots carry
+ * X1600_MSC_BP_FREE; claiming one zero-fills the window (the old
+ * g_malloc0 chunk semantics) before keying it. */
+#define X1600_MSC_BP_FREE 0xffffffffu
+
 static uint8_t *x1600_msc_bp_chunk(X1600Msc *s, uint32_t bp)
 {
     unsigned ci;
 
     for (ci = 0; ci < 16; ci++) {
-        if (s->bp_chunks[ci] && s->bp_keys[ci] == (bp >> 15)) {
-            return s->bp_chunks[ci];
+        if (s->bp_keys[ci] != X1600_MSC_BP_FREE &&
+            s->bp_keys[ci] == (bp >> 15)) {
+            return s->bp_windows[ci];
         }
     }
     for (ci = 0; ci < 16; ci++) {
-        if (!s->bp_chunks[ci]) {
-            s->bp_chunks[ci] = g_malloc0(0x8000);
+        if (s->bp_keys[ci] == X1600_MSC_BP_FREE) {
+            memset(s->bp_windows[ci], 0, sizeof(s->bp_windows[ci]));
             s->bp_keys[ci] = bp >> 15;
-            return s->bp_chunks[ci];
+            return s->bp_windows[ci];
         }
     }
     return NULL;
@@ -1456,13 +1493,66 @@ static const uint8_t x1600_msc_cis_f2[] = {
     0xff,                               /* CISTPL_END */
 };
 
+static int x1600_msc_post_load(void *opaque, int version_id)
+{
+    X1600Msc *s = opaque;
+
+    x1600_msc_update_irq(s);
+    return 0;
