 static void x1600_msc_init(X1600Msc *s, bool sdio_card, hwaddr base,
                            int irq_line, qemu_irq intc_line)
 {
     memset(s->cccr, 0, sizeof(s->cccr));
     memset(s->cis, 0, sizeof(s->cis));
     memset(s->fn1, 0, sizeof(s->fn1));
-    /* Backplane: chunked window (see bp_chunks). Chunk 0x18000000+
+    /* Backplane: chunked window (see bp_windows). Chunk 0x18000000+
      * word 0 = the chipcommon CHIPID badge the DHD's si_doattach reads
      * as the "F1 signature": chipid = low 16 bits (BCM43430A1/AP6212 =
      * 0xa9a6, matches the common-CIS MANFID device and the
@@ -1470,12 +1560,16 @@ static void x1600_msc_init(X1600Msc *s, bool sdio_card, hwaddr base,
      * rev = bits 31:28 (rev 1 routes ai_scan to the bcm43430 tables). */
     {
         uint32_t sig = 0x1000a9a6u;
-        s->bp_chunks[0] = g_malloc0(0x8000);
+        unsigned wi;
+
+        for (wi = 0; wi < 16; wi++) {
+            s->bp_keys[wi] = X1600_MSC_BP_FREE;
+        }
         s->bp_keys[0] = 0x18000000u >> 15;
-        s->bp_chunks[0][0] = sig;
-        s->bp_chunks[0][1] = sig >> 8;
-        s->bp_chunks[0][2] = sig >> 16;
-        s->bp_chunks[0][3] = sig >> 24;
+        s->bp_windows[0][0] = sig;
+        s->bp_windows[0][1] = sig >> 8;
+        s->bp_windows[0][2] = sig >> 16;
+        s->bp_windows[0][3] = sig >> 24;
         /* SOCSRAM core (0x18004000) registers for si_socram_size
          * (v0.72 decode: coreinfo at curmap+0, bits[7:4] = the bank
          * count for socram rev >= 8; socram_banksize reads bankinfo at
@@ -1483,8 +1577,8 @@ static void x1600_msc_init(X1600Msc *s, bool sdio_card, hwaddr base,
          * 2 banks x ((31+1) << 13) = 512 KB SRAM, matching the
          * [0x80000, ...) unmapped rule; socram_banksize asserts
          * idx < 3, so 2 banks, not 4). */
-        s->bp_chunks[0][0x4000] = 0x20;   /* coreinfo: 2 banks */
-        s->bp_chunks[0][0x4040] = 0x1f;   /* bankinfo: 256 KB/bank */
+        s->bp_windows[0][0x4000] = 0x20;  /* coreinfo: 2 banks */
+        s->bp_windows[0][0x4040] = 0x1f;  /* bankinfo: 256 KB/bank */
     }
     /* Backplane chunk key 0 = [0x00000000, 0x8000): the AI EROM
      * (enumeration ROM). ai_scan's cold path reads the EROM pointer
@@ -1527,13 +1621,12 @@ static void x1600_msc_init(X1600Msc *s, bool sdio_card, hwaddr base,
         };
         unsigned i;
 
-        s->bp_chunks[1] = g_malloc0(0x8000);
         s->bp_keys[1] = 0;
         for (i = 0; i < sizeof(erom) / sizeof(erom[0]); i++) {
-            s->bp_chunks[1][4 * i + 0] = erom[i];
-            s->bp_chunks[1][4 * i + 1] = erom[i] >> 8;
-            s->bp_chunks[1][4 * i + 2] = erom[i] >> 16;
-            s->bp_chunks[1][4 * i + 3] = erom[i] >> 24;
+            s->bp_windows[1][4 * i + 0] = erom[i];
+            s->bp_windows[1][4 * i + 1] = erom[i] >> 8;
+            s->bp_windows[1][4 * i + 2] = erom[i] >> 16;
+            s->bp_windows[1][4 * i + 3] = erom[i] >> 24;
         }
     }
     s->cccr[0x00] = 0x11;               /* CCCR rev 1.0, SDIO spec rev 1.1 */
@@ -1571,6 +1664,7 @@ static void x1600_msc_init(X1600Msc *s, bool sdio_card, hwaddr base,
                           sdio_card ? "x1600.msc1-wifi" : "x1600.msc0",
