+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, X1600Cgu, 0x100 / 4),
+        VMSTATE_UINT32_ARRAY(written, X1600Cgu, 0x100 / 32),
+        VMSTATE_END_OF_LIST()
